{
  "manifest_version": 3,
  "name": "CodeFrame",
  "version": "1.0.0",
  "description": "代码美化截图工具 - 截图标注与代码美化于一体的 Chrome 扩展",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "CodeFrame"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "clipboardWrite",
    "scripting"
  ],
  "optional_permissions": [
    "desktopCapture"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icons/*", "themes/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "截取可视区域"
    },
    "capture-region": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "选择区域截图"
    },
    "capture-fullpage": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "整页截图"
    }
  }
}
